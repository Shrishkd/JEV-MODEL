# ── JEV provider ─────────────────────────────────────────────────────────────
# auto (default): TypeSafe key if present → else Vercel AI Gateway key → else mock
# Force one with: typesafe | vercel | mock
JEV_PROVIDER=auto

# Option A — Vercel AI Gateway (works today). Needs a card on the Vercel account.
AI_GATEWAY_API_KEY=

# Option B — TypeSafe direct. When you get a key, paste it here; nothing else changes.
TYPESAFE_API_KEY=

# ── BERT (same model as Moodify) ─────────────────────────────────────────────
# Local: run bert-service/ and point here (real forward-pass timings).
BERT_SERVICE_URL=http://127.0.0.1:8000
# Production: leave BERT_SERVICE_URL unset and use Hugging Face's hosted copy.
HF_TOKEN=

# ── JEV quota (protects your card) ───────────────────────────────────────────
# One "try" = one race / aspects run / benchmark run. 0 = unlimited.
JEV_TRIES_PER_DAY=3
JEV_MAX_CALLS_PER_TRY=40
JEV_GLOBAL_DAILY_CALLS=500
# Optional: Upstash Redis (Vercel Marketplace, free tier) makes the quota hold across
# Vercel's serverless instances. Without it, counts live in memory per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Link back to the blog (its own Vercel project)
NEXT_PUBLIC_BLOG_URL=http://localhost:3000

# Optional hardening if you deploy the lab publicly
LAB_RATE_LIMIT_PER_MIN=300

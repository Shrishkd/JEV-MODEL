# ── JEV provider ─────────────────────────────────────────────────────────────
# auto (default): TypeSafe key if present → else Vercel AI Gateway key → else mock
# Force one with: typesafe | vercel | mock
JEV_PROVIDER=auto

# Option A — Vercel AI Gateway (works today). Needs a card on the Vercel account.
AI_GATEWAY_API_KEY=

# Option B — TypeSafe direct. When you get a key, paste it here; nothing else changes.
TYPESAFE_API_KEY=

# ── BERT service (bert-service/, FastAPI) ────────────────────────────────────
BERT_SERVICE_URL=http://127.0.0.1:8000

# Optional hardening if you deploy the lab publicly
LAB_RATE_LIMIT_PER_MIN=300
